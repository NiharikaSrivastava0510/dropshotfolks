rules_version = '2';
// Paste into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Keep this list in sync with DSF_ADMINS in firebase-config.js.
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['info@dropshotfolks.co.uk'];
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    // Court n plays level n by default; the organiser can change this per session.
    function defaultLevel(c) {
      return c == 1 ? 'D-' : (c == 2 ? 'D+' : (c == 3 ? 'C-' : 'C+'));
    }
    function courtLevels(sid, c) {
      return get(/databases/$(database)/documents/sessions/$(sid)).data
        .get('courts', {}).get(string(c), {}).get('levels', [defaultLevel(c)]);
    }
    // A booking must be on a court for its level, and a player's own booking must use their registered level.
    function levelFitsCourt(d) {
      return d.court is int && d.level in courtLevels(d.sessionId, d.court)
        && (d.get('hostId', null) != null
            || d.level == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.level);
    }

    function shortText(v, n) { return v is string && v.size() <= n; }
    function levelCode(v) { return v in ['E', 'D-', 'D+', 'C-', 'C+']; }
    // What a player may store on their own record.
    function validPlayer(d) {
      return d.keys().hasOnly(['email', 'name', 'phone', 'level', 'quiz', 'verified', 'levelRequest', 'createdAt', 'remind'])
        && shortText(d.name, 80) && d.name.size() > 0
        && (!('phone' in d) || shortText(d.phone, 30))
        && levelCode(d.level)
        && (d.get('levelRequest', null) == null || levelCode(d.levelRequest))
        && (!('quiz' in d) || (d.quiz is map && d.quiz.size() <= 10))
        && (!('remind' in d) || (d.remind is list && d.remind.size() <= 20))
        && (!('createdAt' in d) || shortText(d.createdAt, 40));
    }
    // What a player may store on a booking they make. The document id must be
    // "<session>_<their uid>" (or "..._g<n>" for a guest) so ids can't carry anything else.
    function validBooking(id, d) {
      return d.keys().hasOnly(['playerId', 'hostId', 'name', 'level', 'quiz', 'sessionId', 'court', 'status', 'ref', 'createdAt', 'log'])
        && d.sessionId is string && d.sessionId.matches('[A-Za-z0-9_-]{1,80}')
        && shortText(d.name, 120) && levelCode(d.level)
        && shortText(d.ref, 30) && shortText(d.createdAt, 40)
        && d.log is list && d.log.size() <= 30
        && (!('quiz' in d) || (d.quiz is map && d.quiz.size() <= 10))
        && (d.get('hostId', null) == null
            ? (id == d.sessionId + '_' + request.auth.uid && d.playerId == request.auth.uid)
            : (id.matches(d.sessionId + '_' + request.auth.uid + '_g[0-9]{1,2}')
               && d.playerId.matches('guest-' + request.auth.uid + '-[0-9]{1,2}')));
    }

    // Session view: a device that entered the session's code (stored in unlocks/{uid}) may
    // enter Court 4 scores and mark who's here for that session only. Changing the code
    // in the organiser view locks every device out again.
    function unlockOk(sid) {
      let u = /databases/$(database)/documents/unlocks/$(request.auth.uid);
      return signedIn() && exists(u) && get(u).data.sessionId == sid
        && get(u).data.code == get(/databases/$(database)/documents/secrets/$(sid)).data.code;
    }

    // Club details and sessions: everyone reads, only the organiser writes.
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /sessions/{id} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if unlockOk(id) && onlyChanges(['scores'])
        && request.resource.data.scores is map && request.resource.data.scores.keys().hasOnly(['4']);
    }
    // Session codes: only the organiser can see or change them.
    match /secrets/{sid} {
      allow read, write: if isAdmin();
    }
    match /unlocks/{uid} {
      allow read, delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['sessionId', 'code', 'at'])
        && request.resource.data.sessionId is string && request.resource.data.code is string
        && request.resource.data.code == get(/databases/$(database)/documents/secrets/$(request.resource.data.sessionId)).data.code;
    }

    // Player records hold contact details: only the player and the organiser see them.
    match /players/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.verified == false
        && request.resource.data.get('levelRequest', null) == null
        && validPlayer(request.resource.data));
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && onlyChanges(['levelRequest', 'name', 'phone', 'remind'])
        && validPlayer(request.resource.data));
      allow delete: if isAdmin();
    }

    // Bookings drive the live courts, so everyone can read them (names and courts only, no contact details).
    match /bookings/{id} {
      allow read: if true;
      allow create: if isAdmin() || (signedIn()
        && (request.resource.data.playerId == request.auth.uid || request.resource.data.hostId == request.auth.uid)
        && request.resource.data.status in ['awaiting', 'waitlist']
        && validBooking(id, request.resource.data)
        && levelFitsCourt(request.resource.data));
      // Players can only mark their own (or their guests') booking as paid or cancelled.
      allow update: if isAdmin() || (signedIn()
        && (resource.data.playerId == request.auth.uid || resource.data.hostId == request.auth.uid)
        && ((onlyChanges(['status', 'log'])
             && request.resource.data.status in ['paid', 'cancelled']
             && request.resource.data.log is list && request.resource.data.log.size() <= 30)
          // rebooking a session they cancelled earlier
          || (resource.data.status == 'cancelled'
             && request.resource.data.status in ['awaiting', 'waitlist']
             && request.resource.data.playerId == resource.data.playerId
             && request.resource.data.get('hostId', null) == resource.data.get('hostId', null)
             && validBooking(id, request.resource.data)
             && levelFitsCourt(request.resource.data))));
      // session view devices: check-in only
      allow update: if unlockOk(resource.data.sessionId)
        && onlyChanges(['absent', 'checkedIn', 'log'])
        && request.resource.data.get('absent', false) is bool
        && request.resource.data.get('checkedIn', false) is bool
        && request.resource.data.get('log', []) is list && request.resource.data.get('log', []).size() <= 60;
      allow delete: if isAdmin();
    }

    // Small profile photos shown on the live courts.
    match /photos/{uid} {
      allow read: if true;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['img', 'updatedAt'])
        && request.resource.data.img is string && request.resource.data.img.size() < 200000
        && request.resource.data.img.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'));
    }
  }
}
