+/* ---------- Summer Schedule (calendar) ---------- */
+.schedule-meta{
+  display:flex;flex-wrap:wrap;align-items:baseline;gap:.6rem 1.2rem;
+  font-family:'Geist Mono',monospace;
+  font-size:.78rem;letter-spacing:.18em;text-transform:uppercase;
+  color:var(--maroon);
+  margin:-1.2rem 0 1.6rem;
+}
+.schedule-meta b{
+  font-family:'Fraunces',serif;font-weight:500;font-style:italic;
+  font-size:1rem;letter-spacing:-.01em;text-transform:none;
+  color:var(--maroon-deep);
+}
+.schedule-grid{
+  display:grid;
+  grid-template-columns:repeat(3,1fr);
+  gap:1.5rem;
+  margin-top:1.5rem;
+}
+.schedule-card{
+  background:var(--cream);
+  border:1px solid var(--rule);
+  border-radius:10px;
+  padding:1.6rem 1.4rem;
+  display:flex;flex-direction:column;
+  box-shadow:0 18px 40px -25px rgba(90,22,32,.25);
+  transition:transform .35s ease, box-shadow .35s ease;
+}
+.schedule-card:hover{
+  transform:translateY(-4px);
+  box-shadow:0 26px 55px -25px rgba(90,22,32,.35);
+}
+.schedule-card-head{
+  display:flex;justify-content:space-between;align-items:baseline;
+  padding-bottom:.9rem;
+  border-bottom:1px solid var(--rule);
+  margin-bottom:1rem;
+}
+.schedule-day{
+  font-family:'Fraunces',serif;font-weight:400;
+  font-size:1.7rem;line-height:1;
+  color:var(--maroon-deep);
+}
+.schedule-time{
+  font-family:'Geist Mono',monospace;
+  font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;
+  color:var(--maroon);
+}
+.schedule-venue{
+  font-size:.92rem;line-height:1.4;
+  color:#3a1d22;
+  margin-bottom:.2rem;
+}
+.schedule-venue b{font-weight:500}
+.schedule-venue small{
+  display:block;
+  font-family:'Geist Mono',monospace;
+  font-size:.68rem;letter-spacing:.15em;text-transform:uppercase;
+  color:var(--beige-deep);
+  margin-top:.25rem;
+}
+.schedule-list{
+  list-style:none;margin:1.2rem 0 0;padding:0;
+  display:flex;flex-direction:column;
+}
+.schedule-list li{
+  display:flex;justify-content:space-between;align-items:center;
+  padding:.55rem 0;
+  border-bottom:1px dashed var(--rule);
+  font-size:.95rem;
+}
+.schedule-list li:last-child{border-bottom:none}
+.schedule-list .date{
+  font-family:'Fraunces',serif;font-weight:300;
+  color:var(--maroon-deep);
+}
+.schedule-list .courts{
+  font-family:'Geist Mono',monospace;
+  font-size:.68rem;letter-spacing:.15em;text-transform:uppercase;
+  color:var(--maroon);
+  background:rgba(90,22,32,.06);
+  padding:.25rem .55rem;border-radius:999px;
+}
+.schedule-totals{
+  display:grid;grid-template-columns:repeat(4,1fr);
+  gap:1rem;
+  margin-top:2.4rem;padding:1.6rem clamp(1rem,2vw,1.6rem);
+  background:var(--maroon-deep);color:var(--cream);
+  border-radius:10px;
+  text-align:center;
+}
+.schedule-totals div b{
+  display:block;
+  font-family:'Fraunces',serif;font-weight:400;
+  font-size:2.2rem;line-height:1;color:var(--cream);
+  margin-bottom:.3rem;
+}
+.schedule-totals div span{
+  font-family:'Geist Mono',monospace;
+  font-size:.65rem;letter-spacing:.18em;text-transform:uppercase;
+  color:var(--beige-deep);
+}
+.schedule-tubes{
+  margin-top:1.2rem;
+  font-family:'Geist Mono',monospace;
+  font-size:.7rem;letter-spacing:.1em;color:var(--maroon-soft);
+  line-height:1.6;
+}
+.schedule-download{
+  display:inline-flex;align-items:center;gap:.5rem;
+  margin-top:1.4rem;
+  padding:.75rem 1.4rem;border-radius:999px;
+  border:1.5px solid var(--maroon);color:var(--maroon);
+  font-family:'Geist',sans-serif;font-size:.9rem;font-weight:500;
+  text-decoration:none;
+  transition:all .25s ease;
+}
+.schedule-download:hover{background:var(--maroon);color:var(--cream)}
+.schedule-download svg{width:16px;height:16px}
+@media (max-width:980px){.schedule-grid{grid-template-columns:1fr}}
+@media (max-width:520px){
+  .schedule-totals{grid-template-columns:repeat(2,1fr);gap:.8rem}
+  .schedule-totals div b{font-size:1.8rem}
+}
